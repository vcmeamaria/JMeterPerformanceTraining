                  <boolProp name="HTTPArgument.always_encode">false</boolProp>
                  <stringProp name="Argument.name">ss</stringProp>
                  <stringProp name="Argument.value">{&quot;image_url&quot;:[{&quot;rid&quot;:&quot;2298336457620230&quot;,&quot;v&quot;:[&quot;https://images.zigcdn.com/images/revamp/citysprites.png&quot;]}],&quot;page_description&quot;:[{&quot;rid&quot;:&quot;1039219538978074&quot;,&quot;v&quot;:[&quot;Cars under 4 Lakh\nCars under 6 Lakh\nCars under 10 Lakh\nCars under 15 Lakh\nCars under 20 Lakh\nCars under 40 Lakh\nCars above 40 Lakh&quot;]},{&quot;rid&quot;:&quot;1744671500124768&quot;,&quot;v&quot;:[&quot;Cancel&quot;]}],&quot;page_title&quot;:[{&quot;rid&quot;:&quot;1800171314762006&quot;,&quot;v&quot;:[&quot;Browse Cars By&quot;]},{&quot;rid&quot;:&quot;1729346571664713&quot;,&quot;v&quot;:[&quot;Find Your Dream Car or Bike&quot;]}],&quot;entity_description&quot;:[{&quot;rid&quot;:&quot;1569553287981102&quot;,&quot;v&quot;:[&quot;Browse Bikes By\nBudget\nBrand\nDisplacement\nBikes under 70000\nBikes under 1 Lakh\nBikes under 2 Lakh\nBikes under 5 Lakh\nBikes above 5 Lakh&quot;]}],&quot;author&quot;:[{&quot;rid&quot;:&quot;38232203193094123&quot;,&quot;v&quot;:[&quot;Home&quot;]},{&quot;rid&quot;:&quot;1774395930241539&quot;,&quot;v&quot;:[&quot;Download ZigWheels app&quot;]}],&quot;page_url&quot;:[{&quot;rid&quot;:&quot;1055568437371873&quot;,&quot;v&quot;:[&quot;NEW CARS&quot;]}],&quot;strikethrough_price&quot;:[{&quot;rid&quot;:&quot;2973001113077039&quot;,&quot;v&quot;:[&quot;Browse Bikes By\nBudget\nBrand\nDisplacement\nBikes under 70000\nBikes under 1 Lakh\nBikes under 2 Lakh\nBikes under 5 Lakh\nBikes above 5 Lakh&quot;]}],&quot;page_type&quot;:[{&quot;rid&quot;:&quot;2477747662717890&quot;,&quot;v&quot;:[&quot;The Maruti Suzuki Dzire is priced at ₹7.53 lakh onwards (ex-showroom, Siliguri). For an exact on-road price quotation, colour availability, commercial number plate details, and further assistance, we kindly recommend contacting your nearest authorized Maruti Suzuki dealership. Click the link below to find dealership details based on your city: https://www.zigwheels.com/dealers/maruti-suzuki/Siliguri&quot;,&quot;The ARAI-claimed range of the E3 Trion is 128 Km/Charge. However, the actual mileage may vary based on factors such as riding style, traffic conditions, terrain, load, and battery health.&quot;,&quot;The Komaki XR7 is equipped with a battery designed for everyday use and is suitable for regular commuting. The ARAI-claimed range is up to 322 km per charge. However, the actual real-world range may vary depending on factors such as riding style, speed, traffic conditions, road/terrain, rider and load weight, weather, and battery condition.&quot;,&quot;For daily travelling of around 80–100 km in Hyderabad, both the Kabira Mobility KM3000 and KM4000 can be considered, depending on your requirements. The better choice would depend on factors such as range, performance, charging time, riding comfort, and budget. If your daily usage is consistently on the higher side, we recommend considering the model that offers a suitable real-world range with some additional range buffer. Since actual range can vary based on traffic, riding style, road conditi&quot;,&quot;The Maruti Suzuki Victoris is available in multiple colour options, including Bluish Black, Eternal Blue with Bluish Black Roof, Eternal Blue, Magma Grey, Mystic Green, Pearl Arctic White, Sizzling Red with Bluish Black Roof, Sizzling Red, Splendid Silver with Bluish Black Roof, and Splendid Silver. The choice of colour is completely a matter of individual preference and personal choice. For the latest information regarding colour availability and waiting period, we recommend connecting with you&quot;,&quot;The Gaura Sniper 5G delivers efficient electric performance with a claimed range of 40 - 60 km per charge. However, the actual range may vary depending on factors such as riding speed, load, terrain, and riding style. For more detailed specifications, you can click on the link provided: https://www.zigwheels.com/gaura-electric-bikes/sniper-5g/specifications/&quot;]}],&quot;publisher&quot;:[{&quot;rid&quot;:&quot;4360198047458776&quot;,&quot;v&quot;:[&quot;Download ZigWheels app&quot;]}],&quot;price_range&quot;:[{&quot;rid&quot;:&quot;1342780484341490&quot;,&quot;v&quot;:[&quot;Browse Bikes By\nBudget\nBrand\nDisplacement\nBikes under 70000\nBikes under 1 Lakh\nBikes under 2 Lakh\nBikes under 5 Lakh\nBikes above 5 Lakh&quot;]}],&quot;currencies_accepted&quot;:[{&quot;rid&quot;:&quot;4404183999801526&quot;,&quot;v&quot;:[&quot;NEWS &amp; REVIEWS NEW CARS NEW BIKES\nSearch New Bikes\nLatest Bikes\nPopular Bikes\nUpcoming Bikes\nElectric Bikes\nBike Comparisons\nBike Dealers\nBike Offers &amp; Discounts\n SCOOTERS MORE&quot;]}]}</stringProp>
